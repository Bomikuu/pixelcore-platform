{
	email {$CADDY_EMAIL}
	on_demand_tls {
		ask http://backend:8000/api/internal/domains/authorize/?key={$PIXELCORE_CADDY_AUTH_TOKEN}
	}
}

(pixelcore_routes) {
	encode zstd gzip

	@api path /api/* /admin/*
	reverse_proxy @api backend:8000

	handle /sitemap.xml {
		rewrite * /api/public/site/sitemap.xml
		reverse_proxy backend:8000
	}

	handle /robots.txt {
		rewrite * /api/public/site/robots.txt
		reverse_proxy backend:8000
	}

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy frontend:3000
	}
}

{$PIXELCORE_PLATFORM_DOMAIN}, *.{$PIXELCORE_PLATFORM_DOMAIN} {
	import pixelcore_routes
}

https:// {
	tls {
		on_demand
	}
	import pixelcore_routes
}
